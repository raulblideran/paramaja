[Desktop Entry]
Type=Application
Version=1.0
Name=Paramaja
GenericName=Video Player
Comment=Play any video, tonemap HDR to SDR, and stream straight from magnet links
Exec=paramaja %U
TryExec=paramaja
Icon=io.github.raulblideran.Paramaja
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;movie;player;hdr;hevc;torrent;magnet;subtitles;mpv;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/mp2t;video/x-flv;video/x-ms-wmv;video/3gpp;video/ogg;video/x-m4v;video/vnd.avi;audio/x-matroska;x-scheme-handler/magnet;
StartupNotify=true
StartupWMClass=io.github.raulblideran.Paramaja
