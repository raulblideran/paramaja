+/**
+ * BWDIF (Bob Weaver Deinterlacing Filter) from FFmpeg: called like
+ * RenderYadif() in its framerate doubling mode, and needing the same three
+ * frames of history. Where there is motion it interpolates with the BBC's
+ * W3FDIF coefficients rather than Yadif's spatial guess.
+ */
+int RenderBwdif( filter_t *p_filter, picture_t *p_dst, picture_t *p_src,
+                 int i_order, int i_field );
+
