<v:OverlayWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="using:NegsPlayer.App.Views"
                 xmlns:vm="using:NegsPlayer.App.ViewModels"
                 x:Class="NegsPlayer.App.Views.TopBar"
                 x:DataType="vm:MainViewModel"
                 Title="Negs Player title" Height="72">
  <Border Background="{StaticResource NegsTopScrim}" Padding="18,12,18,18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding MediaTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding TorrentStatus}" FontSize="12" Foreground="{StaticResource NegsLeaf}"
                     IsVisible="{Binding IsTorrent}" />
          <TextBlock Text="Buffering…" FontSize="12" Classes="muted" IsVisible="{Binding IsBuffering}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <ComboBox Grid.Column="1" VerticalAlignment="Center" MaxWidth="360" IsVisible="{Binding HasTorrentFiles}"
                ItemsSource="{Binding TorrentFiles}" SelectedItem="{Binding SelectedTorrentFile}"
                ToolTip.Tip="Files in this torrent" />
    </Grid>
  </Border>
</v:OverlayWindow>
