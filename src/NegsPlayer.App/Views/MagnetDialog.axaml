<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NegsPlayer.App.ViewModels"
        x:Class="NegsPlayer.App.Views.MagnetDialog"
        x:DataType="vm:MagnetDialogViewModel"
        Title="Open magnet link" Icon="/Assets/negs.ico"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#15111A">
  <StackPanel Margin="24" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <PathIcon Data="{StaticResource IconMagnet}" Width="22" Height="22" Foreground="{StaticResource NegsAccentBright}" />
      <TextBlock Text="Stream a torrent" FontSize="20" FontWeight="SemiBold" />
    </StackPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Paste a magnet link or info hash. Playback starts as soon as the first pieces arrive; the largest video file is picked automatically." />
    <TextBox x:Name="Input" Text="{Binding Text}" Watermark="magnet:?xt=urn:btih:…" AcceptsReturn="False"
             TextWrapping="Wrap" MaxHeight="120" />
    <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource NegsAccentBright}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button Classes="accent" Content="Play" Click="OnPlay" IsDefault="True" IsEnabled="{Binding IsValid}" />
    </StackPanel>
  </StackPanel>
</Window>
