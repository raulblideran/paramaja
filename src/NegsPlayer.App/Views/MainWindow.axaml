<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NegsPlayer.App.ViewModels"
        xmlns:c="using:NegsPlayer.App.Controls"
        x:Class="NegsPlayer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}" Icon="/Assets/negs.ico"
        Width="1280" Height="760" MinWidth="720" MinHeight="420"
        Background="#0B0910" DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- mpv renders into this native surface -->
    <c:VideoHost x:Name="Video" />

    <!-- Welcome / idle screen (the video surface is collapsed while idle) -->
    <Grid x:Name="Welcome" IsVisible="{Binding IsIdle}" Background="#0B0910">
      <Grid.Background>
        <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="70%" RadiusY="70%">
          <GradientStop Offset="0" Color="#2A1532" />
          <GradientStop Offset="1" Color="#0B0910" />
        </RadialGradientBrush>
      </Grid.Background>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="560">
        <Image Source="/Assets/negs-256.png" Width="128" Height="128" />
        <TextBlock Classes="h1" Text="Negs Player" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Drop a video here, paste a magnet link with Ctrl+V, or pick a file." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
          <Button Classes="accent" Command="{Binding OpenFileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
              <TextBlock Text="Open file" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding OpenMagnetCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconMagnet}" Width="16" Height="16" />
              <TextBlock Text="Magnet link" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding PasteAndPlayCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconPaste}" Width="16" Height="16" />
              <TextBlock Text="Paste" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
          </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsResolvingMagnet}" Spacing="6" Margin="0,10,0,0">
          <ProgressBar IsIndeterminate="True" Width="280" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource NegsAccentBright}" />

        <StackPanel IsVisible="{Binding RecentItems.Count}" Margin="0,16,0,0" Spacing="2">
          <TextBlock Classes="section" Text="Recent" HorizontalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding RecentItems}" MaxHeight="220">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="6"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding}" TextTrimming="PrefixCharacterEllipsis" FontSize="12" MaxWidth="540" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Panel>
</Window>
