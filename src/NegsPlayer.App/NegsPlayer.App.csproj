<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NegsPlayer</AssemblyName>
    <RootNamespace>NegsPlayer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\negs.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Version>1.0.0</Version>
    <Product>Negs Player</Product>
    <Description>Modern portable video player with HDR tonemapping and magnet streaming</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="NegsPlayer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Native libraries (libmpv + negs_torrent) are staged in libs/<rid> by build/fetch-libs.sh. -->
  <PropertyGroup>
    <NegsNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NegsNativeRid>
    <NegsNativeRid Condition="'$(NegsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</NegsNativeRid>
    <NegsNativeRid Condition="'$(NegsNativeRid)' == ''">linux-x64</NegsNativeRid>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\libs\$(NegsNativeRid)\**\*" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NegsPlayer.Core\NegsPlayer.Core.csproj" />
  </ItemGroup>

</Project>
