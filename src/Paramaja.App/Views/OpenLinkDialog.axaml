<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paramaja.App.ViewModels"
        x:Class="Paramaja.App.Views.OpenLinkDialog"
        x:DataType="vm:OpenLinkDialogViewModel"
        Title="Open link" Icon="/Assets/paramaja.ico"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#15111A">
  <StackPanel Margin="24" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <PathIcon Data="{StaticResource IconMagnet}" Width="22" Height="22" Foreground="{StaticResource ParamajaAccentBright}" />
      <TextBlock Text="Open a link" FontSize="20" FontWeight="SemiBold" />
    </StackPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Paste a magnet link, a MEGA file link, a YouTube (or other site) link, or a direct video URL. Streams start once a few seconds are buffered." />
    <TextBox x:Name="Input" Text="{Binding Text}" Watermark="magnet:?…  ·  https://mega.nz/file/…  ·  https://youtube.com/watch?v=…" AcceptsReturn="False"
             TextWrapping="Wrap" MaxHeight="120" />
    <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource ParamajaAccentBright}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button Classes="accent" Content="Play" Click="OnPlay" IsDefault="True" IsEnabled="{Binding IsValid}" />
    </StackPanel>
  </StackPanel>
</Window>
