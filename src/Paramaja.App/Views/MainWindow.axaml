<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paramaja.App.ViewModels"
        xmlns:c="using:Paramaja.App.Controls"
        x:Class="Paramaja.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}" Icon="/Assets/paramaja.ico"
        Width="1280" Height="760" MinWidth="720" MinHeight="420"
        Background="#0B0910" DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- mpv renders into this native surface -->
    <c:VideoHost x:Name="Video" />
    <!-- libVLC renders discs (with their menus) into this one; only one surface is shown at a time -->
    <c:VideoHost x:Name="DiscVideo" />

    <!-- Welcome / idle screen (the video surface is collapsed while idle) -->
    <Grid x:Name="Welcome" IsVisible="{Binding IsIdle}" Background="#0B0910">
      <TextBlock Text="{Binding AppVersionLine}" Classes="muted" FontSize="11" Opacity="0.7"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,10" />
      <Grid.Background>
        <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="70%" RadiusY="70%">
          <GradientStop Offset="0" Color="#2A1532" />
          <GradientStop Offset="1" Color="#0B0910" />
        </RadialGradientBrush>
      </Grid.Background>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="560">
        <Image Source="/Assets/paramaja-256.png" Width="128" Height="128" />
        <TextBlock Classes="h1" Text="Paramaja" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Drop a video or folder here, paste a magnet, YouTube or MEGA link with Ctrl+V, or open a file, folder, disc or link." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
          <Button x:Name="OpenMenu" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
              <TextBlock Text="Open" />
              <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Open file" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open folder" InputGesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="Open Disc" Command="{Binding OpenDiscCommand}"
                          ToolTip.Tip="DVD, Blu-ray or Audio CD, from a drive or a folder" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="OpenLinkButton" Classes="ghost" Command="{Binding OpenLinkCommand}"
                  ToolTip.Tip="Magnet, YouTube, MEGA or any video URL (Ctrl+U)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconLink}" Width="16" Height="16" />
              <TextBlock Text="Open Link" />
            </StackPanel>
          </Button>
          <Button x:Name="DownloaderButton" Classes="ghost" Command="{Binding OpenDownloaderCommand}"
                  ToolTip.Tip="Download a YouTube (or other site) video in the quality you choose, or just its audio">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconDownload}" Width="16" Height="16" />
              <TextBlock Text="Download Video" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
          </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsResolving}" Spacing="6" Margin="0,10,0,0">
          <ProgressBar IsIndeterminate="True" Width="280" />
          <TextBlock Text="{Binding BufferingText}" HorizontalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{StaticResource ParamajaAccentBright}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource ParamajaAccentBright}" />
      </StackPanel>
    </Grid>
  </Panel>
</Window>
