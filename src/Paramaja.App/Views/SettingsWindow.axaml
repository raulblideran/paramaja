<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paramaja.App.ViewModels"
        x:Class="Paramaja.App.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Settings — Paramaja" Icon="/Assets/paramaja.ico"
        Width="720" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#15111A">
  <TabControl Margin="12" TabStripPlacement="Left">
    <TabItem Header="Video">
      <ScrollViewer>
        <StackPanel Margin="16,0" Spacing="8">
          <TextBlock Classes="section" Text="HDR" />
          <ComboBox SelectedIndex="{Binding HdrModeIndex}" Width="460" HorizontalAlignment="Left">
            <ComboBoxItem Content="Auto — passthrough on an HDR display, tonemap on SDR (default)" />
            <ComboBoxItem Content="Always tonemap HDR to SDR" />
            <ComboBoxItem Content="Always pass HDR through to the display" />
          </ComboBox>
          <TextBlock Text="{Binding HdrStatusText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Expander x:Name="TonemapAdvanced" Header="Advanced: tonemapping" IsVisible="{Binding HdrTonemap}"
                    HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Tonemapping curve" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="160" ItemsSource="{Binding ToneMappingCurves}" SelectedItem="{Binding ToneMapping}" />
              </Grid>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="spline: balanced default · bt.2446a: brighter, closer to PotPlayer · bt.2390: the ITU reference curve · hable: filmic" />
              <ToggleSwitch IsChecked="{Binding HdrDynamicPeak}"
                            OnContent="Scene-adaptive brightness (measures each frame)" OffContent="Use the disc's static metadata" />
              <StackPanel>
                <TextBlock Text="{Binding HdrContrastRecovery, StringFormat='Highlight detail recovery: {0:0.00}'}" />
                <Slider Minimum="0" Maximum="1" Value="{Binding HdrContrastRecovery}" />
              </StackPanel>
            </StackPanel>
          </Expander>

          <TextBlock Classes="section" Text="Deinterlacing" />
          <ComboBox SelectedIndex="{Binding DeinterlaceIndex}" Width="320">
            <ComboBoxItem Content="Auto — only interlaced content" />
            <ComboBoxItem Content="Always on" />
            <ComboBoxItem Content="Off" />
          </ComboBox>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Uses BWDIF, a motion-adaptive deinterlacer that outputs one frame per field (50i becomes 50p)." />

          <TextBlock Classes="section" Text="Decoding" />
          <ToggleSwitch IsChecked="{Binding HardwareDecoding}" OnContent="Hardware acceleration (D3D11 / VA-API)" OffContent="Software decoding" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Used for HEVC (H.265) at any size and for every codec from 1080p up; smaller videos decode in software." />
          <Expander x:Name="RenderingAdvanced" Header="Advanced: rendering quality" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <ComboBox SelectedIndex="{Binding RenderQualityIndex}" Width="420" HorizontalAlignment="Left">
                <ComboBoxItem Content="Auto — High below 4K, Balanced for 4K" />
                <ComboBoxItem Content="High — best scaling, needs a strong GPU for 4K" />
                <ComboBoxItem Content="Balanced — nearly as sharp, far lighter (default)" />
                <ComboBoxItem Content="Fast — lightest, for laptops and older GPUs" />
              </ComboBox>
              <TextBlock Text="{Binding RenderProfileText}" Classes="muted" FontSize="12" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Scaling a 4K picture costs about five times as much as 1080p. If 4K stutters while 1080p is fine, the GPU is running out of time: Balanced or Fast fixes it. Auto also switches to Fast by itself if frames keep dropping." />
              <TextBlock Classes="section" Text="Playback timing" />
              <ComboBox SelectedIndex="{Binding DisplayFpsIndex}" Width="420" HorizontalAlignment="Left">
                <ComboBoxItem Content="60 Hz (default)" />
                <ComboBoxItem Content="Auto — the rate the monitor reports" />
                <ComboBoxItem Content="50 Hz" />
                <ComboBoxItem Content="75 Hz" />
                <ComboBoxItem Content="120 Hz" />
                <ComboBoxItem Content="144 Hz" />
              </ComboBox>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="The refresh rate playback is timed for. If video stutters on one monitor but not another, try matching this to that monitor's refresh rate, or Auto." />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Audio">
      <StackPanel Margin="16,0" Spacing="8">
        <TextBlock Classes="section" Text="Surround" />
        <ToggleSwitch IsChecked="{Binding DownmixToStereo}" OnContent="Downmix 5.1 / 7.1 to stereo" OffContent="Output original channels (default)" />
        <TextBlock Classes="section" Text="Stereo" />
        <ToggleSwitch IsChecked="{Binding DownmixToMono}" OnContent="Downmix stereo to mono" OffContent="Output original channels (default)" />
        <TextBlock Classes="section" Text="Volume" />
        <ToggleSwitch IsChecked="{Binding NormalizeAudio}" OnContent="Normalize volume (evens out loud and quiet parts)" OffContent="Original dynamics (default)" />
        <TextBlock Classes="section" Text="Receiver" />
        <ToggleSwitch IsChecked="{Binding AudioPassthrough}" OnContent="Passthrough Dolby / DTS to an AV receiver" OffContent="Decode audio in the player (default)" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="All off by default: the audio plays as-is. Each downmix applies only to the sources it's for (stereo to 5.1 / 7.1, mono to stereo). No ReplayGain or downmix normalisation is ever applied." />
        <TextBlock Classes="section" Text="Preferred audio languages" />
        <TextBox Text="{Binding PreferredAudioLanguages}" Watermark="e.g. jpn,eng" Width="320" HorizontalAlignment="Left" />
      </StackPanel>
    </TabItem>

    <TabItem Header="Subtitles">
      <StackPanel Margin="16,0" Spacing="8">
        <TextBlock Classes="section" Text="Loading" />
        <ToggleSwitch IsChecked="{Binding AutoLoadExternalSubtitles}" OnContent="Auto-load matching subtitle files next to the video" OffContent="Only embedded subtitles" />
        <TextBlock Classes="section" Text="Preferred subtitle languages" />
        <TextBox Text="{Binding PreferredSubtitleLanguages}" Watermark="e.g. eng,spa" Width="320" HorizontalAlignment="Left" />
        <TextBlock Classes="section" Text="{Binding SubtitleSizeText}" />
        <Slider Minimum="0.5" Maximum="2.5" Value="{Binding SubtitleScale}" Width="320" HorizontalAlignment="Left" />
      </StackPanel>
    </TabItem>

    <TabItem Header="Torrents">
      <StackPanel Margin="16,0" Spacing="8">
        <TextBlock Classes="section" Text="Cache" />
        <ToggleSwitch IsChecked="{Binding ClearTorrentCacheOnExit}" OnContent="Delete downloaded data when closing" OffContent="Keep downloaded data in the cache folder" />
        <Button Content="Open cache folder" Command="{Binding OpenCacheFolderCommand}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Only the file you're watching is downloaded, prioritised around the playhead so seeking works. Data lives in the 'cache' folder next to the app." />
      </StackPanel>
    </TabItem>

    <TabItem Header="Playback">
      <StackPanel Margin="16,0" Spacing="8">
        <TextBlock Classes="section" Text="Seeking" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Arrow key jump (seconds)" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding SeekSeconds}" Minimum="1" Maximum="600" Increment="1" FormatString="0" Width="130" />
        </StackPanel>
        <TextBlock Classes="section" Text="Screenshots" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Lossless, uncompressed PNG at the video's native resolution (16-bit for HDR/10-bit sources), saved to the 'Screenshots' folder next to the app." />
        <Button Content="Open screenshots folder" Command="{Binding OpenScreenshotsFolderCommand}" />
        <TextBlock Classes="section" Text="YouTube &amp; other sites" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Links from YouTube and ~1800 other sites play through yt-dlp. Sites change often; if one stops working, update it." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Streaming quality" VerticalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding StreamQualityIndex}" Width="220">
            <ComboBoxItem Content="Best available (default)" />
            <ComboBoxItem Content="Up to 2160p (4K)" />
            <ComboBoxItem Content="Up to 1440p" />
            <ComboBoxItem Content="Up to 1080p" />
            <ComboBoxItem Content="Up to 720p" />
            <ComboBoxItem Content="Up to 480p" />
            <ComboBoxItem Content="Up to 360p" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Update YouTube support" Command="{Binding UpdateYtDlpCommand}" IsEnabled="{Binding HasYtDlp}" />
          <Button Content="Open downloads folder" Command="{Binding OpenDownloadsFolderCommand}" />
          <TextBlock Text="{Binding YtDlpStatus}" VerticalAlignment="Center" Classes="muted" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </TabItem>

    <TabItem Header="About">
      <StackPanel Margin="16,0" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <Image Source="/Assets/paramaja-256.png" Width="72" Height="72" />
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="Paramaja" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="VersionText" Text="{Binding AppVersion, StringFormat='Version {0}'}" Classes="muted" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Copy version" Click="OnCopyVersion" />
          <Button Content="Copy diagnostics (Ctrl+I)" Command="{Binding CopyDiagnosticsCommand}"
                  ToolTip.Tip="While the problem video is playing: copies the machine, the video and why it's struggling" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="When reporting a problem, include the version above: the part in brackets is the exact build." />
        <TextBlock Classes="section" Text="Licence" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="GPL-3.0-or-later. Built on mpv, FFmpeg, libplacebo, librqbit, Avalonia, yt-dlp and QuickJS-NG. CHANGELOG.txt next to the app lists what changed in each version." />
        <TextBlock Text="github.com/raulblideran/paramaja" Classes="muted" FontSize="12" />
      </StackPanel>
    </TabItem>

    <TabItem Header="Shortcuts">
      <ScrollViewer>
        <ItemsControl Margin="16,8" ItemsSource="{Binding Shortcuts}" x:Name="ShortcutList" />
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
