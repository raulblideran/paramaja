<v:OverlayWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="using:Paramaja.App.Views"
                 xmlns:vm="using:Paramaja.App.ViewModels"
                 x:Class="Paramaja.App.Views.TopBar"
                 x:DataType="vm:MainViewModel"
                 Title="Paramaja title" Height="72">
  <Border Background="{StaticResource ParamajaTopScrim}" Padding="18,12,18,18">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding MediaTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding TorrentStatus}" FontSize="12" Foreground="{StaticResource ParamajaLeaf}"
                     IsVisible="{Binding IsTorrent}" />
          <TextBlock Text="{Binding BufferingText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ParamajaAccentBright}"
                     IsVisible="{Binding IsBuffering}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <ComboBox Grid.Column="1" VerticalAlignment="Center" MaxWidth="360" IsVisible="{Binding HasTorrentFiles}"
                ItemsSource="{Binding TorrentFiles}" SelectedItem="{Binding SelectedTorrentFile}"
                ToolTip.Tip="Files in this torrent" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
        <Button x:Name="DownloadButton" Classes="icon" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}"
                ToolTip.Tip="Download this video: choose the quality">
          <PathIcon Data="{StaticResource IconDownload}" />
        </Button>
        <TextBlock Text="{Binding DownloadStatus}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsDownloading}"
                   Foreground="{StaticResource ParamajaLeaf}" />
        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}"
                ToolTip.Tip="Stop the download and delete the partial file" />
      </StackPanel>
    </Grid>
  </Border>
</v:OverlayWindow>
