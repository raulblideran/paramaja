<v:OverlayWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="using:Paramaja.App.Views"
                 xmlns:vm="using:Paramaja.App.ViewModels"
                 xmlns:c="using:Paramaja.App.Controls"
                 x:Class="Paramaja.App.Views.ControlsBar"
                 x:DataType="vm:MainViewModel"
                 Title="Paramaja controls" Height="118">
  <Border Background="{StaticResource ParamajaBottomScrim}" Padding="14,18,14,10">
    <Grid RowDefinitions="Auto,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Classes="time" Text="{Binding PositionText}" Margin="0,10,0,0" />
        <c:SeekBar x:Name="Seek" Grid.Column="1" Margin="6,0" Value="{Binding Position}"
                   Maximum="{Binding Duration}" Buffered="{Binding BufferedUntil}" />
        <TextBlock Grid.Column="2" Classes="time" Text="{Binding DurationText}" Margin="0,10,0,0" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button x:Name="PreviousFileButton" Classes="icon" Command="{Binding PreviousFileCommand}" IsVisible="{Binding HasTorrentFiles}"
                  ToolTip.Tip="Previous file in this torrent">
            <PathIcon Data="{StaticResource IconPlaylistPrev}" />
          </Button>
          <Button x:Name="FrameBackButton" Classes="icon" Command="{Binding FrameBackStepCommand}" IsVisible="{Binding !IsAudioOnly}"
                  ToolTip.Tip="Previous frame ( , )">
            <PathIcon Data="{StaticResource IconFramePrev}" />
          </Button>
          <Button Classes="icon big" Command="{Binding TogglePauseCommand}" ToolTip.Tip="Play / Pause (Space)">
            <Panel>
              <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused}" />
              <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused}" />
            </Panel>
          </Button>
          <Button x:Name="FrameNextButton" Classes="icon" Command="{Binding FrameStepCommand}" IsVisible="{Binding !IsAudioOnly}"
                  ToolTip.Tip="Next frame ( . )">
            <PathIcon Data="{StaticResource IconFrameNext}" />
          </Button>
          <Button x:Name="NextFileButton" Classes="icon" Command="{Binding NextFileCommand}" IsVisible="{Binding HasTorrentFiles}"
                  ToolTip.Tip="Next file in this torrent">
            <PathIcon Data="{StaticResource IconPlaylistNext}" />
          </Button>
          <Button x:Name="StopButton" Classes="icon" Command="{Binding StopCommand}" ToolTip.Tip="Stop (Ctrl+S)">
            <PathIcon Data="{StaticResource IconStop}" />
          </Button>
          <Button x:Name="PreviousChapterButton" Classes="icon" Command="{Binding PreviousChapterCommand}" IsVisible="{Binding HasChapters}"
                  ToolTip.Tip="Previous chapter (Page Up)" Margin="6,0,0,0">
            <PathIcon Data="{StaticResource IconChapterPrev}" />
          </Button>
          <Button x:Name="NextChapterButton" Classes="icon" Command="{Binding NextChapterCommand}" IsVisible="{Binding HasChapters}"
                  ToolTip.Tip="Next chapter (Page Down)">
            <PathIcon Data="{StaticResource IconChapterNext}" />
          </Button>
          <Button Classes="icon" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)" Margin="8,0,0,0">
            <Panel>
              <PathIcon Data="{StaticResource IconVolume}" IsVisible="{Binding !IsMuted}" />
              <PathIcon Data="{StaticResource IconMute}" IsVisible="{Binding IsMuted}" />
            </Panel>
          </Button>
          <Slider Width="110" Minimum="0" Maximum="150" Value="{Binding Volume}" VerticalAlignment="Center"
                  SmallChange="5" LargeChange="10" Focusable="False"
                  ToolTip.Tip="{Binding VolumeDecibels, StringFormat='Volume {0} (logarithmic)'}" />
          <TextBlock Classes="time muted" Text="{Binding VolumeText}" Margin="6,0,0,0" FontSize="12"
                     ToolTip.Tip="{Binding VolumeDecibels}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Classes="badge hdr" IsVisible="{Binding HdrBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding HdrBadge}" />
          </Border>
          <Border x:Name="CodecBadge" Classes="badge" ToolTip.Tip="{Binding CodecTip}"
                  IsVisible="{Binding CodecBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding CodecBadge}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding ResolutionBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ResolutionBadge}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding DecoderBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding DecoderBadge}" />
          </Border>
          <Border x:Name="AudioBadge" Classes="badge" ToolTip.Tip="{Binding AudioTip}"
                  IsVisible="{Binding AudioBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding AudioBadge}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding DeinterlaceBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="{Binding DeinterlaceTip}">
            <TextBlock Text="{Binding DeinterlaceBadge}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button x:Name="DiscMenuButton" Classes="icon" Command="{Binding ShowDiscMenuCommand}" IsVisible="{Binding CanShowDiscMenu}"
                  ToolTip.Tip="Disc menu (arrow keys and Enter move through it)">
            <PathIcon Data="{StaticResource IconHome}" />
          </Button>

          <Button x:Name="ChaptersButton" Classes="icon" ToolTip.Tip="Titles &amp; chapters" IsVisible="{Binding HasChapterMenu}">
            <PathIcon Data="{StaticResource IconChapters}" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <ScrollViewer MaxHeight="460" Width="340">
                  <StackPanel Spacing="4">
                    <StackPanel IsVisible="{Binding HasDiscTitles}" Spacing="2" Margin="0,0,0,8">
                      <TextBlock Classes="section" Text="Titles" Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding DiscTitles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChapterItem">
                            <RadioButton GroupName="titles" Content="{Binding Label}" IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                         Command="{Binding $parent[v:ControlsBar].((vm:MainViewModel)DataContext).SelectDiscTitleCommand}"
                                         CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasChapters}" Spacing="2">
                      <TextBlock Classes="section" Text="Chapters" Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding Chapters}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChapterItem">
                            <RadioButton GroupName="chapters" Content="{Binding Label}" IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                         Command="{Binding $parent[v:ControlsBar].((vm:MainViewModel)DataContext).GoToChapterCommand}"
                                         CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Page Up / Page Down jump to the previous / next chapter" />
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Classes="icon" ToolTip.Tip="Subtitles">
            <PathIcon Data="{StaticResource IconSubtitles}" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <StackPanel Width="320" Spacing="4">
                  <TextBlock Classes="section" Text="Subtitles" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TrackItem">
                        <RadioButton GroupName="subs" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding $parent[v:ControlsBar].((vm:MainViewModel)DataContext).SelectSubtitleCommand}"
                                     CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Load subtitle file…" Command="{Binding LoadSubtitleCommand}" Margin="0,6,0,0" />
                  <TextBlock Classes="section" Text="{Binding SubtitleSizeText}" />
                  <Slider Minimum="0.5" Maximum="2.5" Value="{Binding SubtitleScale}" SmallChange="0.05" LargeChange="0.25"
                          ToolTip.Tip="{Binding SubtitleSizeText}" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="J cycles tracks · V hides · Z / X shift timing by 0.1 s" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Classes="icon" ToolTip.Tip="Audio">
            <PathIcon Data="{StaticResource IconAudio}" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <StackPanel Width="320" Spacing="4">
                  <TextBlock Classes="section" Text="Audio track" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding AudioTracks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TrackItem">
                        <RadioButton GroupName="audio" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding $parent[v:ControlsBar].((vm:MainViewModel)DataContext).SelectAudioCommand}"
                                     CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="SurroundOptions" Spacing="4" IsVisible="{Binding IsSurroundAudio}">
                    <TextBlock Classes="section" Text="Surround (5.1 / 7.1)" />
                    <ToggleSwitch IsChecked="{Binding DownmixToStereo}" OnContent="Downmix to stereo"
                                  OffContent="Original channels (default)" />
                  </StackPanel>
                  <StackPanel x:Name="StereoOptions" Spacing="4" IsVisible="{Binding IsStereoAudio}">
                    <TextBlock Classes="section" Text="Stereo channels (this video)" />
                    <ComboBox x:Name="StereoChannel" SelectedIndex="{Binding StereoChannelIndex}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Both channels (default)" />
                      <ComboBoxItem Content="Left channel only" />
                      <ComboBoxItem Content="Right channel only" />
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Classes="section" Text="Volume" />
                  <ToggleSwitch IsChecked="{Binding NormalizeAudio}" OnContent="Normalize volume (evens out loud and quiet parts)"
                                OffContent="Original dynamics (default)" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="The original audio stream plays as-is, 5.1 as 5.1, unless you choose a downmix, one channel or normalization. A stereo track is picked by default where there is one. Passthrough to an AV receiver is in Settings → Developer." />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button x:Name="VideoMenuButton" Classes="icon" ToolTip.Tip="Video" IsVisible="{Binding !IsAudioOnly}">
            <PathIcon Data="{StaticResource IconVideo}" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <StackPanel Width="340" Spacing="6">
                  <StackPanel x:Name="PictureOptions" Spacing="6" IsVisible="{Binding HasPictureOptions}">
                    <TextBlock Classes="section" Text="Picture (this video)" />
                    <ToggleSwitch x:Name="ResizeSwitch" IsChecked="{Binding ResizeTo4x3}" IsVisible="{Binding CanResizeTo4x3}"
                                  OnContent="Resized to 4:3" OffContent="Resize to 4:3" />
                    <ToggleSwitch x:Name="CropSwitch" IsChecked="{Binding CropTo16x9}" IsVisible="{Binding CanCropTo16x9}"
                                  OnContent="Cropped to 16:9" OffContent="Crop to 16:9" />
                  </StackPanel>
                  <StackPanel x:Name="StreamQualityOptions" Spacing="6" IsVisible="{Binding HasStreamQualities}">
                    <TextBlock Classes="section" Text="YouTube quality (this video)" />
                    <ComboBox x:Name="StreamQuality" ItemsSource="{Binding StreamQualities}"
                              SelectedIndex="{Binding StreamQualityChoiceIndex}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="Deinterlacing, hardware decoding, HDR and rendering are in Settings → Developer." />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Classes="icon" Command="{Binding ScreenshotCommand}" CommandParameter="{x:False}"
                  ToolTip.Tip="Lossless PNG screenshot (S, Shift+S with subtitles)">
            <PathIcon Data="{StaticResource IconCamera}" />
          </Button>

          <Button x:Name="DownloadVideoButton" Classes="icon" Command="{Binding OpenDownloaderCommand}"
                  ToolTip.Tip="Download Video: pick a quality, or just the audio">
            <PathIcon Data="{StaticResource IconDownload}" />
          </Button>

          <Button Classes="icon" Command="{Binding OpenLinkCommand}" ToolTip.Tip="Open Link: magnet, YouTube, MEGA or any video URL (Ctrl+U)">
            <PathIcon Data="{StaticResource IconLink}" />
          </Button>

          <Button x:Name="OpenMenuButton" Classes="icon" ToolTip.Tip="Open">
            <PathIcon Data="{StaticResource IconFolder}" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight">
                <MenuItem Header="Open file" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open folder" InputGesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="Open Disc" Command="{Binding OpenDiscCommand}"
                          ToolTip.Tip="DVD, Blu-ray or Audio CD, from a drive or a folder" />
                <MenuItem Header="Rip Disc…" Command="{Binding OpenRipperCommand}"
                          ToolTip.Tip="Rip an Audio CD to FLAC or WAV (AccurateRip, MusicBrainz), or a DVD to MKV or its VIDEO_TS folder" />
                <Separator />
                <MenuItem Header="Screenshots folder" Command="{Binding OpenScreenshotsFolderCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings">
            <PathIcon Data="{StaticResource IconSettings}" />
          </Button>
          <Button Classes="icon" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Fullscreen (F, double-click)">
            <Panel>
              <PathIcon Data="{StaticResource IconFullscreen}" IsVisible="{Binding !IsFullscreen}" />
              <PathIcon Data="{StaticResource IconFullscreenExit}" IsVisible="{Binding IsFullscreen}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</v:OverlayWindow>
