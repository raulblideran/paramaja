<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Paramaja</AssemblyName>
    <RootNamespace>Paramaja.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\paramaja.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.3.0</Version>
    <Product>Paramaja</Product>
    <Description>Modern portable video player with HDR tonemapping and magnet streaming</Description>
    <Company>Raul Blideran</Company>
    <Copyright>© 2026 Raul Blideran · GPL-3.0-or-later</Copyright>
    <!-- The commit is appended by build/publish-win.sh (SourceRevisionId), e.g. 1.1.0+50919f7. -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="Paramaja.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Native libraries (libmpv + paramaja_torrent) are staged in libs/<rid> by build/fetch-libs.sh. -->
  <PropertyGroup>
    <ParamajaNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ParamajaNativeRid>
    <ParamajaNativeRid Condition="'$(ParamajaNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</ParamajaNativeRid>
    <ParamajaNativeRid Condition="'$(ParamajaNativeRid)' == ''">linux-x64</ParamajaNativeRid>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\libs\$(ParamajaNativeRid)\**\*" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramaja.Core\Paramaja.Core.csproj" />
  </ItemGroup>

</Project>
