 // 32 mb lookahead by default.
 const PER_STREAM_BUF_DEFAULT: u64 = 32 * 1024 * 1024;
 
+// PARAMAJA PATCH: the lookahead is configurable, because 32 MB is about three
+// seconds of a 4K remux. Pieces inside the window are still queued strictly in
+// order, so a bigger window reads further ahead without delaying the next piece.
+static PER_STREAM_BUF: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(PER_STREAM_BUF_DEFAULT);
+
+/// Sets how far ahead of its read position every stream prioritises pieces.
+pub fn set_stream_readahead(bytes: u64) {
+    PER_STREAM_BUF.store(bytes.max(PER_STREAM_BUF_DEFAULT), std::sync::atomic::Ordering::Relaxed);
+}
+
+pub fn stream_readahead() -> u64 {
+    PER_STREAM_BUF.load(std::sync::atomic::Ordering::Relaxed)
+}
